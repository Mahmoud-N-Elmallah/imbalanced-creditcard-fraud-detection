# Kaggle API credentials. Create these in your Kaggle account settings.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# DagsHub MLflow tracking.
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=https://dagshub.com/mahmoudelmalah85/imbalanced-creditcard-fraud-detection.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# DagsHub DVC remote. Configure DVC auth locally with these values, not in .dvc/config.
DVC_REMOTE_URL=https://dagshub.com/mahmoudelmalah85/imbalanced-creditcard-fraud-detection.dvc
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token
